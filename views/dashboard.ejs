<h2>Welcome, <%= user.name %> 👋</h2>
<a href="/leave" class="btn">Request New Leave</a>

<h3>Your Leave Requests</h3>
<table>
  <tr>
    <th>Type</th>
    <th>Dates</th>
    <th>Reason</th>
    <th>Status</th>
    <th>Manager Comment</th>
  </tr>
  <% leaves.forEach(leave => { 
       const start = new Date(leave.start_date).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
       const end = new Date(leave.end_date).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
  %>
    <tr>
      <td><%= leave.type %></td>
      <td><%= start %> → <%= end %></td>
      <td><%= leave.reason %></td>
      <td class="<%= leave.status.toLowerCase() %>"><%= leave.status %></td>
      <td><%= leave.manager_comment || "-" %></td>
    </tr>
  <% }) %>
</table>
