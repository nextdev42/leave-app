<h2>Manager Dashboard</h2>
<h3>All Leave Requests</h3>

<table>
  <tr>
    <th>Employee</th>
    <th>Type</th>
    <th>Dates</th>
    <th>Reason</th>
    <th>Status</th>
    <th>Action</th>
  </tr>
  <% leaves.forEach(leave => { %>
    <tr>
      <td><%= leave.employee_name %></td>
      <td><%= leave.type %></td>
      <td><%= leave.start_date %> → <%= leave.end_date %></td>
      <td><%= leave.reason %></td>
      <td class="<%= leave.status.toLowerCase() %>"><%= leave.status %></td>
      <td>
        <% if (leave.status === "Pending") { %>
          <form method="POST" action="/manager/action/<%= leave.id %>" class="action-form">
            <input type="text" name="comment" placeholder="Comment">
            <button name="action" value="approve" class="btn success">Approve</button>
            <button name="action" value="reject" class="btn danger">Reject</button>
          </form>
        <% } else { %>
          <%= leave.manager_comment || "-" %>
        <% } %>
      </td>
    </tr>
  <% }) %>
</table>
